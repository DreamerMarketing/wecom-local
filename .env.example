# Copy this file to .env for local overrides. Never commit .env.
# The default ignored file is .local/wecom-local/wecom-webhook.url.
# WECOM_WEBHOOK_URL='https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME'
# WECOM_ORG_LABEL='组织名称'

# Optional paths when using Codex Desktop's bundled dependencies.
# WECOM_NODE_BIN='/path/to/node'
# WECOM_ARTIFACT_TOOL='/path/to/artifact_tool.mjs'
# WECOM_LOCAL_BIN='/path/to/target/release/wecom-local'
